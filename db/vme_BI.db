	field(DTYP,"INSTIO_BI")
	field(INP,"@0x41290000,0,3")
	field(SCAN, "5 second")
	field(ZNAM,"0")
	field(ONAM,"1")
}

record(bi,"ISR") {
	field(DTYP,"INSTIO_BI")
	field(INP,"@0x41290000,0,6")
	field(SCAN, "5 second")
	field(ZNAM,"0")
	field(ONAM,"1")
}

